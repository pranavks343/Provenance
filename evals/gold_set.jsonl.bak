[
  {"id": "q01", "question": "What is the main innovation of the Transformer architecture?", "expected_answer": "The Transformer is the first sequence transduction model based entirely on attention mechanisms, dispensing with recurrence and convolutions entirely.", "expected_pages": [1, 2], "category": "core_concept"},

  {"id": "q02", "question": "Why did the authors want to move away from recurrent models?", "expected_answer": "Recurrent models factor computation along symbol positions sequentially, which precludes parallelization within training examples and becomes critical at longer sequence lengths due to memory constraints.", "expected_pages": [2], "category": "core_concept"},

  {"id": "q03", "question": "Why is multi-head attention beneficial over single-head attention?", "expected_answer": "Multi-head attention allows the model to jointly attend to information from different representation subspaces at different positions, while a single head's averaging inhibits this.", "expected_pages": [5], "category": "core_concept"},

  {"id": "q04", "question": "Why are the dot products scaled by 1/sqrt(d_k) in scaled dot-product attention?", "expected_answer": "For large values of d_k, dot products grow large in magnitude, pushing softmax into regions with extremely small gradients. Scaling by 1/sqrt(d_k) counteracts this effect.", "expected_pages": [4], "category": "core_concept"},

  {"id": "q05", "question": "What are the three desiderata motivating the use of self-attention?", "expected_answer": "Total computational complexity per layer, the amount of computation that can be parallelized (minimum sequential operations), and path length between long-range dependencies in the network.", "expected_pages": [6], "category": "core_concept"},

  {"id": "q06", "question": "Why did the authors choose sinusoidal positional encoding over learned embeddings?", "expected_answer": "Both produced nearly identical results, but they chose the sinusoidal version because it may allow the model to extrapolate to sequence lengths longer than those encountered during training.", "expected_pages": [6], "category": "core_concept"},

  {"id": "q07", "question": "What BLEU score did the Transformer achieve on WMT 2014 English-to-German translation?", "expected_answer": "The big Transformer model achieved 28.4 BLEU on WMT 2014 English-to-German, improving over previous best results (including ensembles) by over 2 BLEU.", "expected_pages": [1, 8], "category": "technical_detail"},

  {"id": "q08", "question": "How many layers are in the encoder and decoder stacks, and what is d_model?", "expected_answer": "Both encoder and decoder are composed of a stack of N=6 identical layers, and all sub-layers and embedding layers produce outputs of dimension d_model=512.", "expected_pages": [3], "category": "technical_detail"},

  {"id": "q09", "question": "How many attention heads does the Transformer use, and what are their dimensions?", "expected_answer": "The Transformer uses h=8 parallel attention heads, with d_k = d_v = d_model/h = 64 for each head.", "expected_pages": [5], "category": "technical_detail"},

  {"id": "q10", "question": "What is the structure and inner dimensionality of the position-wise feed-forward network?", "expected_answer": "It consists of two linear transformations with ReLU in between: FFN(x) = max(0, xW1 + b1)W2 + b2. Input/output dimension is d_model=512 and inner layer dimension is d_ff=2048.", "expected_pages": [5], "category": "technical_detail"},

  {"id": "q11", "question": "What optimizer settings and learning rate schedule were used?", "expected_answer": "Adam with β1=0.9, β2=0.98, ε=10^-9. Learning rate increases linearly for the first warmup_steps=4000 steps, then decreases proportional to inverse square root of step number.", "expected_pages": [7], "category": "technical_detail"},

  {"id": "q12", "question": "What hardware was used and how long did the base and big models train?", "expected_answer": "Training used 8 NVIDIA P100 GPUs. Base models trained 100,000 steps in 12 hours (0.4s/step); big models trained 300,000 steps in 3.5 days (1.0s/step).", "expected_pages": [7], "category": "technical_detail"},

  {"id": "q13", "question": "What dropout rate and label smoothing values were used for the base model?", "expected_answer": "Residual dropout rate P_drop=0.1 applied to sub-layer outputs and embedding+positional encoding sums, and label smoothing of value ε_ls=0.1.", "expected_pages": [7, 8], "category": "technical_detail"},

  {"id": "q14", "question": "What were the beam search hyperparameters used during inference?", "expected_answer": "Beam search with beam size 4 and length penalty α=0.6. Maximum output length set to input length + 50, but terminating early when possible.", "expected_pages": [8], "category": "technical_detail"},

  {"id": "q15", "question": "What is Scaled Dot-Product Attention?", "expected_answer": "An attention function computed as softmax(QK^T / sqrt(d_k)) * V, where queries and keys have dimension d_k and values have dimension d_v.", "expected_pages": [4], "category": "definition"},

  {"id": "q16", "question": "What is self-attention?", "expected_answer": "Self-attention (also called intra-attention) is an attention mechanism relating different positions of a single sequence in order to compute a representation of the same sequence.", "expected_pages": [2], "category": "definition"},

  {"id": "q17", "question": "What is an attention function in general terms?", "expected_answer": "An attention function maps a query and a set of key-value pairs to an output, where the output is a weighted sum of the values, and the weight on each value is computed by a compatibility function of the query with the corresponding key.", "expected_pages": [3, 4], "category": "definition"},

  {"id": "q18", "question": "What is positional encoding in the Transformer?", "expected_answer": "Positional encodings are vectors of the same dimension d_model as the embeddings, added to the input embeddings at the bottom of the encoder and decoder stacks to inject information about the relative or absolute position of tokens in the sequence.", "expected_pages": [6], "category": "definition"},

  {"id": "q19", "question": "How does additive attention differ from dot-product attention?", "expected_answer": "Additive attention computes the compatibility function using a feed-forward network with a single hidden layer, while dot-product attention uses matrix multiplication. They have similar theoretical complexity, but dot-product attention is faster and more space-efficient in practice.", "expected_pages": [4], "category": "comparison"},

  {"id": "q20", "question": "How does the decoder layer differ from the encoder layer?", "expected_answer": "The decoder inserts a third sub-layer that performs multi-head attention over the encoder stack output, and its self-attention sub-layer is masked to prevent positions from attending to subsequent positions, preserving the auto-regressive property.", "expected_pages": [3], "category": "comparison"},

  {"id": "q21", "question": "Compare the per-layer complexity and maximum path length of self-attention versus recurrent layers.", "expected_answer": "Self-attention has O(n^2·d) complexity with O(1) path length, while recurrent layers have O(n·d^2) complexity with O(n) path length. Self-attention is faster when n is smaller than d.", "expected_pages": [6], "category": "comparison"},

  {"id": "q22", "question": "How do the base and big Transformer models differ in architecture and parameters?", "expected_answer": "Base: d_model=512, d_ff=2048, h=8, P_drop=0.1, 65M params, trained 100K steps. Big: d_model=1024, d_ff=4096, h=16, P_drop=0.3, 213M params, trained 300K steps.", "expected_pages": [9], "category": "comparison"},

  {"id": "q23", "question": "How does the Transformer's training cost on English-to-French compare to previous state-of-the-art models, and was it better in quality?", "expected_answer": "The Transformer (big) achieved a higher BLEU of 41.8 at training cost of 2.3·10^19 FLOPs, less than 1/4 the cost of the previous state-of-the-art single model and far less than ensembles like GNMT+RL Ensemble at 1.1·10^21 FLOPs.", "expected_pages": [1, 8], "category": "multi_hop"},

  {"id": "q24", "question": "How does the Transformer's encoder-decoder attention mechanism relate to its self-attention layers, and what masking is applied where?", "expected_answer": "In encoder-decoder attention, queries come from the decoder while keys/values come from the encoder output. Encoder self-attention uses Q, K, V all from the previous encoder layer with no masking. Decoder self-attention is masked (setting illegal softmax inputs to −∞) to prevent attending to subsequent positions.", "expected_pages": [3, 5], "category": "multi_hop"},

  {"id": "q25", "question": "Does the Transformer generalize beyond machine translation, and what evidence supports this?", "expected_answer": "Yes. Applied to English constituency parsing on the WSJ Penn Treebank, a 4-layer Transformer achieved 91.3 F1 (WSJ-only) and 92.7 F1 (semi-supervised) on WSJ Section 23, outperforming all previously reported models except the Recurrent Neural Network Grammar, despite minimal task-specific tuning.", "expected_pages": [9, 10], "category": "multi_hop"},

  {"id": "q26", "question": "How did the authors validate the importance of multi-head attention and key dimension choices?", "expected_answer": "Through ablation studies on newstest2013: single-head attention was 0.9 BLEU worse than the best setting, quality dropped with too many heads, and reducing key size d_k hurt quality, suggesting that determining compatibility is non-trivial and a more sophisticated function than dot product may help.", "expected_pages": [9], "category": "multi_hop"},

  {"id": "q27", "question": "What happens when label smoothing is applied during Transformer training?", "expected_answer": "Label smoothing with value ε_ls=0.1 hurts perplexity, as the model learns to be more unsure, but it improves accuracy and BLEU score.", "expected_pages": [8], "category": "edge_case"},

  {"id": "q28", "question": "Can the Transformer handle very long sequences efficiently?", "expected_answer": "Self-attention is faster than recurrent layers when n < d, which is typical. For very long sequences, self-attention could be restricted to a neighborhood of size r around each output position, increasing maximum path length to O(n/r). The authors planned to investigate this in future work but did not implement it in the paper.", "expected_pages": [6, 7], "category": "edge_case"},

  {"id": "q29", "question": "What is the recipe for chicken biryani used in the Transformer paper?", "expected_answer": "The paper does not discuss recipes or biryani; it is about the Transformer neural network architecture for sequence transduction tasks like machine translation.", "expected_pages": [], "category": "out_of_scope"},

  {"id": "q30", "question": "What were the carbon emissions of training the Transformer model?", "expected_answer": "The paper does not discuss carbon emissions or environmental impact of training. It only reports training cost in FLOPs and wall-clock time on P100 GPUs.", "expected_pages": [], "category": "out_of_scope"}
]